---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import Alert from '../components/Alert.astro';
import PostNavigation from '../components/PostNavigation.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], showToc, tocMaxDepth, headings = [], draft = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
    {/* Full-bleed Header Section */}
    <header class="editorial-header">
        <div class="header-inner">
            <div class="meta-row">
                <FormattedDate date={pubDate} />
                {updatedDate && (
                    <span class="last-updated">
                        (Updated <FormattedDate date={updatedDate} />)
                    </span>
                )}
            </div>

            <h1 class="post-title">{title}</h1>

            {description && <p class="post-description">{description}</p>}

            {tags.length > 0 && (
                <div class="tags">
                    {tags.map((tag) => (
                        <a href={`/tags/${tag}`} class="tag">#{tag}</a>
                    ))}
                </div>
            )}
        </div>
    </header>

    <article class="post-article">
        {heroImage && (
            <div class="hero-image">
                <Image width={1200} height={600} src={heroImage} alt="" />
            </div>
        )}

        <div class="prose">
            {showToc && <TableOfContents headings={headings} maxDepth={tocMaxDepth}/>}
            {draft && (
                <Alert type="warn" badge="DRAFT">
                <p>This post is currently a work in progress! It's subject to change at any time.</p>
                </Alert>
            )}
            <slot />

            <PostNavigation currentPubDate={pubDate} />

            <Comments />
        </div>
    </article>
</BaseLayout>

<style>
    /* Full-width editorial header */
    .editorial-header {
        position: relative;
        padding: 4rem 1.5rem 3rem 1.5rem;
        margin: -2rem -1.5rem 3rem -1.5rem; /* Offsets BaseLayout padding */
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .header-inner {
        max-width: 75ch;
        margin: 0 auto;
        text-align: left; /* Left-aligned titles feel more editorial */
    }

    .meta-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--gray, #9ca3af);
        margin-bottom: 1rem;
    }

    .last-updated {
        font-style: italic;
    }

    .post-title {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0 0 1rem 0;
        color: #ffffff;
    }

    .post-description {
        font-size: 1.25rem;
        line-height: 1.5;
        color: #d1d5db;
        margin: 0 0 1.5rem 0;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--gray-dark, #9ca3af);
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .tag:hover {
        color: #60a5fa;
        border-color: #60a5fa;
    }

    /* Content Area */
    .post-article {
        max-width: 75ch;
        margin: 0 auto;
    }

    .hero-image {
        width: 100%;
        margin-bottom: 2.5rem;
    }

    .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 480px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .prose {
        width: 100%;
        color: rgb(var(--gray-dark));
        font-size: 1.125rem;
        line-height: 1.7;
    }

    @media (max-width: 768px) {
        .editorial-header {
            padding: 2.5rem 1rem 2rem 1rem;
            margin: -2rem -1rem 2rem -1rem;
        }

        .post-title {
            font-size: 2.15rem;
        }

        .post-description {
            font-size: 1.05rem;
        }
    }
</style>