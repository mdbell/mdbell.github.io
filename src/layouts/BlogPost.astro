---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, tags = [], showToc, tocMaxDepth, headings = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <article class="post-article">
        <div class="hero-image">
            {heroImage && <Image width={1200} height={600} src={heroImage} alt="" />}
        </div>
        <div class="prose">
            <div class="title">
                <div class="date">
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <div class="last-updated-on">
                                Last updated on <FormattedDate date={updatedDate} />
                            </div>
                        )
                    }
                </div>
                <h1>{title}</h1>
                {tags.length > 0 && (
                    <div class="tags">
                        {tags.map((tag) => (
                            <a href={`/tags/${tag}`} class="tag">#{tag}</a>
                        ))}
                    </div>
                )}
                <hr />
            </div>
            {showToc && (<TableOfContents headings={headings} maxDepth={tocMaxDepth}/>)}
            <slot />
        </div>
    </article>
</BaseLayout>

<style>
    /* Override BaseLayout main max-width for full blog layout */
    :global(main) {
        max-width: 1000px !important;
        padding: 0 1.5rem !important;
    }

    .hero-image {
        width: 100%;
        margin-bottom: 2rem;
    }
    .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 520px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
    }
    .prose {
        width: 100%;
        max-width: 85ch;
        margin: 0 auto;
        padding: 1em 0;
        color: rgb(var(--gray-dark));
        font-size: 1.125rem;
        line-height: 1.7;
    }
    .title {
        margin-bottom: 2em;
        padding: 1em 0;
        text-align: center;
        line-height: 1.2;
    }
    .title h1 {
        font-size: 2.75rem;
        margin: 0 0 0.5em 0;
    }
    .date {
        margin-bottom: 0.75em;
        color: rgb(var(--gray));
    }
    .last-updated-on {
        font-style: italic;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin: 1rem 0;
    }

    .tag {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--gray-dark, #9ca3af);
        background-color: var(--gray-light, rgba(255, 255, 255, 0.05));
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .tag:hover {
        color: var(--accent, #60a5fa);
        border-color: var(--accent, #60a5fa);
    }

    @media (max-width: 768px) {
        :global(main) {
            padding: 0 1rem !important;
        }
        .title h1 {
            font-size: 2rem;
        }
        .prose {
            font-size: 1rem;
        }
    }
</style>