---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection("blog"))
    .filter((res) => import.meta.env.PROD ? !res.data.draft : true)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
            main {
                width: 960px;
            }
            ul {
                display: flex;
                flex-wrap: wrap;
                gap: 2rem;
                list-style-type: none;
                margin: 0;
                padding: 0;
            }
            ul li {
                width: calc(50% - 1rem);
            }
            ul li * {
                text-decoration: none;
                transition: 0.2s ease;
            }
            ul li:first-child {
                width: 100%;
                margin-bottom: 1rem;
                text-align: center;
            }
            ul li:first-child img {
                width: 100%;
            }
            ul li:first-child .title {
                font-size: 2.369rem;
            }
            ul li img {
                margin-bottom: 0.5rem;
                border-radius: 12px;
            }
            ul li a {
                display: block;
            }
            .title {
                margin: 0;
                color: rgb(var(--black));
                line-height: 1;
            }
            .date {
                margin: 0;
                color: rgb(var(--gray));
            }
            ul li a:hover h4,
            ul li a:hover .date {
                color: rgb(var(--accent));
            }
            ul a:hover img {
                box-shadow: var(--box-shadow);
            }
            .empty-state {
                padding: 4rem 2rem;
                border: 1px dashed rgba(var(--gray), 40%);
                border-radius: 12px;
                text-align: center;
                background-color: rgb(var(--gray-light));
            }
            .empty-state h2 {
                font-size: 1.8rem;
                margin-bottom: 0.5rem;
            }
            .empty-state p {
                margin: 0 0 1.5rem 0;
                color: rgb(var(--gray));
            }
            .empty-state code {
                font-size: 0.9em;
            }
            .home-link {
                display: inline-block;
                font-weight: 600;
                text-decoration: none;
            }
            @media (max-width: 720px) {
                ul {
                    gap: 0.5em;
                }
                ul li {
                    width: 100%;
                    text-align: center;
                }
                ul li:first-child {
                    margin-bottom: 0;
                }
                ul li:first-child .title {
                    font-size: 1.563em;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <section>
                {
                    posts.length > 0 ? (
                        <ul>
                            {posts.map((post) => (
                                <li>
                                    <a href={`/blog/${post.id}/`}>
                                        {post.data.heroImage && (
                                            <Image width={720} height={360} src={post.data.heroImage} alt="" />
                                        )}
                                        <h4 class="title">{post.data.title}</h4>
                                        <p class="date">
                                            <FormattedDate date={post.data.pubDate} />
                                        </p>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    ) : (
                        <div class="empty-state">
                            <h2>You found the secret route! 🕵️‍♂️</h2>
                            <p>
                                Considering I didn't put a link to <code>/blog</code> anywhere in the navigation, 
                                typing that into your address bar was bold. Unfortunately, there are no published posts yet.
                            </p>
                            <a href="/" class="home-link">&larr; Take me back to safety</a>
                        </div>
                    )
                }
            </section>
        </main>
        <Footer />
    </body>
</html>