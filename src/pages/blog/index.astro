---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection("blog"))
    .filter((res) => import.meta.env.PROD ? !res.data.hidden : true)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
    <section>
        {
            posts.length > 0 ? (
                <ul class="post-grid">
                    {posts.map((post, index) => (
                        <PostCard post={post} isFirst={index === 0} />
                    ))}
                </ul>
            ) : (
                <div class="empty-state">
                    <h2>You found the secret route! 🕵️‍♂️</h2>
                    <p>
                        Considering I didn't put a link to <code>/blog</code> anywhere in the navigation, 
                        typing that into your address bar was bold. Unfortunately, there are no published posts yet.
                    </p>
                    <a href="/" class="home-link">&larr; Take me back to safety</a>
                </div>
            )
        }
    </section>
</BaseLayout>

<style>
    .post-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
    }
    .empty-state {
        padding: 4rem 2rem;
        border: 1px dashed rgba(var(--gray), 40%);
        border-radius: 12px;
        text-align: center;
        background-color: rgb(var(--gray-light));
    }
    .empty-state h2 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }
    .empty-state p {
        margin: 0 0 1.5rem 0;
        color: rgb(var(--gray));
    }
    .empty-state code {
        font-size: 0.9em;
    }
    .home-link {
        display: inline-block;
        font-weight: 600;
        text-decoration: none;
    }
    @media (max-width: 720px) {
        .post-grid {
            gap: 0.5em;
        }
    }
</style>